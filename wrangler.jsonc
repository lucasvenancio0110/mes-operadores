{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mes-operadores",
  "main": "worker/secure-main-v64.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mes-operadores-db",
      "database_id": "31666c87-0970-44e1-9969-51458e7888b5",
      "migrations_dir": "migrations"
    }
  ]
}
