{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mes-operadores-pixi-beta",
  "main": "worker/beta-preview.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*"
    ]
  },
  "vars": {
    "NEOMES_PRODUCTION_ORIGIN": "https://mes-operadores.lucassantanals0110.workers.dev"
  }
}
